    {
      "id": 10,
      "type": "table",
      "title": "Productividad por referencia",
      "description": "Las pacas por hora dependen mucho del producto (125cc ≈ 30/h vs 15cc ≈ 5/h): compara máquinas u operarios solo dentro de la misma referencia. Mínimo 20 turnos.",
      "datasource": {
        "type": "mysql",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT referencia AS `Referencia`, COUNT(*) AS `Turnos`, SUM(pacas_producidas) AS `Pacas`, SUM(pacas_producidas) / SUM(horas_trabajadas) AS `Pacas por hora`, SUM(horas_trabajadas - horas_paro) / SUM(horas_planeadas) AS `Disponibilidad`, AVG(horas_paro_no_programado) AS `Paro no prog. (h/turno)` FROM vw_produccion WHERE $__timeFilter(fecha) AND maquina IN ($maquina) AND es_valido_kpi AND referencia <> 'Sin registro' GROUP BY referencia HAVING COUNT(*) >= 20 ORDER BY `Pacas por hora` DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
