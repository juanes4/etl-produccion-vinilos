          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT COALESCE(SUM(es_atipico OR es_inconsistente), 0) AS `Turnos` FROM vw_produccion WHERE $__timeFilter(fecha) AND maquina IN ($maquina)"
