    {
      "id": 9,
      "type": "timeseries",
      "title": "Tendencia de las 3 causas principales (horas por turno)",
      "description": "Horas de paro por turno para alimentación/aseo, ajuste operativo y limpieza por derrame. Normalizado por número de turnos para que los periodos sean comparables.",
      "datasource": {
        "type": "mysql",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT t.time, t.metric, t.horas / n.turnos AS value FROM (SELECT $__timeGroup(fecha, '$intervalo') AS time, tipo_paro AS metric, SUM(horas_paro) AS horas FROM vw_paros WHERE $__timeFilter(fecha) AND maquina IN ($maquina) AND id_paro IN (5, 6, 16) GROUP BY 1, 2) t JOIN (SELECT $__timeGroup(fecha, '$intervalo') AS time, COUNT(*) AS turnos FROM vw_produccion WHERE $__timeFilter(fecha) AND maquina IN ($maquina) GROUP BY 1) n ON n.time = t.time ORDER BY t.time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: h",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "axisSoftMax": null
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 2
        },
        "overrides": [
