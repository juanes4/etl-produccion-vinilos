  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pacas producidas",
      "description": "Excluye turnos atípicos (pacas/hora fuera de rango) e inconsistentes.",
      "datasource": {
        "type": "mysql",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT SUM(pacas_producidas) AS `Pacas` FROM vw_produccion WHERE $__timeFilter(fecha) AND maquina IN ($maquina) AND es_valido_kpi"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Disponibilidad",
      "description": "(horas trabajadas − horas de paro) / (horas trabajadas − paros programados). Los paros programados (aseo, pausas, cambio de insumos, preventivo) no cuentan en contra.",
      "datasource": {
        "type": "mysql",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "${DS}"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT SUM(horas_trabajadas - horas_paro) / SUM(horas_planeadas) AS `Disponibilidad` FROM vw_produccion WHERE $__timeFilter(fecha) AND maquina IN ($maquina) AND es_valido_kpi"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Paro no programado por turno",
      "description": "Horas promedio de paro no programado en cada turno.",
      "datasource": {
        "type": "mysql",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
