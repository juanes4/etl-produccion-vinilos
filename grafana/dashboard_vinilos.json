        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Misma referencia, distinta máquina",
      "description": "Pacas por hora de cada máquina en las referencias que producen varias máquinas (mínimo 20 turnos).",
      "datasource": {
        "type": "mysql",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 12,
