    {
      "id": 4,
      "type": "stat",
      "title": "Turnos excluidos por calidad",
      "description": "Turnos marcados por el ETL como atípicos o con más horas de paro que de trabajo.",
      "datasource": {
        "type": "mysql",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 18,
