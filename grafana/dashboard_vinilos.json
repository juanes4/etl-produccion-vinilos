          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT AVG(horas_paro_no_programado) AS `Horas` FROM vw_produccion WHERE $__timeFilter(fecha) AND maquina IN ($maquina) AND es_valido_kpi"
        }
