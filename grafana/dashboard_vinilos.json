          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT referencia AS `Referencia`, maquina AS `Máquina`, COUNT(*) AS `Turnos`, SUM(pacas_producidas) / SUM(horas_trabajadas) AS `Pacas por hora`, SUM(horas_trabajadas - horas_paro) / SUM(horas_planeadas) AS `Disponibilidad` FROM vw_produccion WHERE $__timeFilter(fecha) AND maquina IN ($maquina) AND es_valido_kpi AND referencia <> 'Sin registro' GROUP BY referencia, maquina HAVING COUNT(*) >= 20 ORDER BY referencia, maquina"
        }
